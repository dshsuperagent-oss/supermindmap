{
  "id": "supermindmap-app",
  "name": "SuperMindMap — Mapa Mental",
  "short_name": "SuperMindMap",
  "description": "Editor de mapa mental offline: escreva em Markdown e o mapa se desenha. Exporta MD, JSON, SVG, PNG e PDF. Funciona no iPad.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./gerador-mapa-mental.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#f6f7fb",
  "theme_color": "#2563eb",
  "categories": ["productivity", "education"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
